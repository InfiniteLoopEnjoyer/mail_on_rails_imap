#!/usr/bin/env ruby
# frozen_string_literal: true

# Entrypoint for the mail_on_rails_imap Kamal service (config/deploy.yml):
# runs the IMAP listeners in the foreground, no Rails and no database
# anywhere in the process. Every store operation goes to the host app's
# private HTTP API (MAIL_ON_RAILS_INTERNAL_API_URL).

require "bundler/setup"
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "mail_on_rails/imap/daemon"

MailOnRails::Imap::Daemon.run!